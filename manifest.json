{
  "manifest_version": 2,
  "name": "ChatGPT Notifier",
  "version": "1.0",
  "permissions": ["tabs", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://chat.openai.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": ["notification2.mp3"],
  "browser_specific_settings": {
  "gecko": {
    "id": "borderify@example.com"
  }
}

}